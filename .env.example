# Example configuration with FICTITIOUS values. Copy to .env (git-ignored) and change the passwords.
# Never commit real credentials.

# Database (docker-compose.yml)
MATRIZ_DB_NAME=matriz
MATRIZ_DB_PORT=5432
# Owner: creates the schema (Flyway)
MATRIZ_DB_OWNER_USER=matriz_owner
MATRIZ_DB_OWNER_PASSWORD=change-me-owner
# Application user: used at runtime; INSERT and SELECT only on the logs
MATRIZ_DB_APP_USER=matriz_app
MATRIZ_DB_APP_PASSWORD=change-me-app

# Backend
MATRIZ_DB_URL=jdbc:postgresql://localhost:5432/matriz
MATRIZ_SERVER_PORT=8080
# Session and CSRF cookies only over HTTPS; false only for local HTTP development
MATRIZ_COOKIE_SECURE=false
# "dev" adds the demo accounts and projects; never use it in production
MATRIZ_PROFILE=dev

# Email (password reset). In development: Mailpit from docker-compose.yml, UI at http://localhost:8025
MATRIZ_MAIL_HOST=localhost
MATRIZ_MAIL_PORT=1025
MATRIZ_MAIL_UI_PORT=8025
MATRIZ_MAIL_USERNAME=
MATRIZ_MAIL_PASSWORD=
MATRIZ_MAIL_FROM=no-reply@example.test
# Address of the frontend, used in the link of the reset email
MATRIZ_APP_URL=http://localhost:5173

# Admin account created at the first start (must change the password at first login)
MATRIZ_ADMIN_NAME=Administrador
MATRIZ_ADMIN_EMAIL=admin@example.test
MATRIZ_ADMIN_PASSWORD=change-me-admin

# Password of the demo accounts manager@example.test and member@example.test (dev profile only)
MATRIZ_DEMO_PASSWORD=change-me-demo

# Frontend (Vite reads this file through envDir)
# API address used by the browser; /api goes through the Vite dev proxy
VITE_API_URL=/api
# Backend address used by the Vite dev proxy
MATRIZ_BACKEND_URL=http://localhost:8080
